---
import { articlesFor } from '../articles';
import { toolHref } from '../tool-links';
import type { Locale } from '../tool-registry';

type Props = { lang: Locale };
const { lang } = Astro.props;
const en = lang === 'en';
const guides = await articlesFor(lang);
const scenarios = (en ? [
  { title: 'Preparing an application', body: 'Set a passport photo size, reduce attachments, and organize documents before sending them.', label: 'Resize & compress', href: toolHref('resize-image', lang), photo: 'passport-photo-sizes-explained' },
  { title: 'Preparing product photos', body: 'Keep product canvases consistent and place a shop logo across multiple images.', label: 'Resize & batch logo', href: toolHref('logo-watermark', lang), photo: 'background-removal-limits' },
  { title: 'Getting photos ready to share', body: 'Choose a story, feed, or profile crop for the image you want to post.', label: 'Social image sizes', href: toolHref('resize-image', lang), photo: 'social-media-image-sizes', preview: 'social' },
] : [
  { title: 'Melengkapi berkas lamaran', body: 'Samakan ukuran pas foto, kecilkan lampiran, lalu rapikan dokumen sebelum dikirim.', label: 'Ubah ukuran & kompres', href: toolHref('resize-image', lang), photo: 'passport-photo-sizes-explained' },
  { title: 'Menyiapkan foto produk', body: 'Buat bidang produk konsisten dan letakkan logo toko pada beberapa foto sekaligus.', label: 'Resize & watermark logo', href: toolHref('logo-watermark', lang), photo: 'background-removal-limits' },
  { title: 'Merapikan foto untuk dibagikan', body: 'Pilih ukuran story, feed, atau profil untuk gambar yang akan dibagikan.', label: 'Ukuran gambar sosial', href: toolHref('resize-image', lang), photo: 'social-media-image-sizes', preview: 'social' },
]).map(scenario => ({ ...scenario, media: guides.find(guide => guide.data.translationKey === scenario.photo)!.data }));
---

<div class="scenario-panel" data-scenario-panel-root>
  <div class="scenario-tabs" role="group" aria-label={en ? 'Choose a use case' : 'Pilih kebutuhan'}>
    {scenarios.map((scenario, index) => <button type="button" data-scenario-tab={index} aria-pressed={index === 0}>{scenario.title}</button>)}
  </div>
  <div aria-live="polite">
    {scenarios.map((scenario, index) => <article class="scenario-detail" data-scenario-panel={index} hidden={index !== 0}>
      <div>
        <h3>{scenario.title}</h3>
        <p>{scenario.body}</p>
        <a class="text-link" href={scenario.href}>{scenario.label}</a>
      </div>
      <figure style="margin:0">{scenario.preview === 'social' ? <div class="scenario-social-preview" role="img" aria-label={scenario.media.imageAlt}>
        <img src={scenario.media.image} alt="" width="1536" height="1024" loading="lazy" />
        <span class="scenario-social-frame" aria-hidden="true"></span>
        <span class="scenario-social-label" aria-hidden="true">9:16</span>
      </div> : <img src={scenario.media.image} alt={scenario.media.imageAlt} width="1536" height="1024" loading="lazy" />}<figcaption class="notice"><a href={scenario.media.imageCreditUrl}>{scenario.media.imageCredit}</a> · <a href={`https://creativecommons.org/${scenario.photo === 'social-media-image-sizes' ? 'publicdomain/zero/1.0' : `licenses/${scenario.media.imageLicense?.replace(' ', '/')}`}/`}>{scenario.media.imageLicense?.toUpperCase()}</a></figcaption></figure>
    </article>)}
  </div>
</div>

<script>
  function initializeScenarios() {
    document.querySelectorAll<HTMLElement>('[data-scenario-panel-root]').forEach(root => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-scenario-tab]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-scenario-panel]'));
      tabs.forEach(tab => tab.addEventListener('click', () => {
        const active = tab.dataset.scenarioTab;
        tabs.forEach(item => item.setAttribute('aria-pressed', String(item === tab)));
        panels.forEach(panel => { panel.hidden = panel.dataset.scenarioPanel !== active; });
      }));
    });
  }

  document.addEventListener('astro:page-load', initializeScenarios);
  initializeScenarios();
</script>
