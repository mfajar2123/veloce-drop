---
import '../styles/global.css';
import '../styles/presets.css';
import ToolFeedback from '../components/ToolFeedback.astro';
import WelcomeNotice from '../components/WelcomeNotice.astro';
import {ClientRouter} from 'astro:transitions';
import SessionTray from '../components/SessionTray.astro';
import ToolReference from '../components/ToolReference.astro';
import {catalog, type Locale} from '../tool-registry';
import {siteConfig} from '../site-config';
const { lang = 'id', title, description = 'Local image tools', trail, article, jsonLd, ogImage } = Astro.props as {
  lang?: Locale;
  title: string;
  description?: string;
  trail?: Array<{ name: string; path?: string }>;
  article?: { publishedAt: Date; updatedAt?: Date };
  jsonLd?: Record<string, unknown>;
  ogImage?: string;
};
const en = lang === 'en';
const targetLang:Locale = en ? 'id' : 'en';
const basePath=(import.meta.env.BASE_URL||'/').replace(/^\/*/,'/').replace(/\/*$/,'/');
const routePath=Astro.url.pathname.startsWith(basePath)&&basePath!=='/'?Astro.url.pathname.slice(basePath.length-1):Astro.url.pathname;
const pathname=routePath.endsWith('/')?routePath:`${routePath}/`;
const tool=catalog.find(item=>item.path[lang as Locale]===pathname);
const pageTitle=tool?.seo?.title[lang as Locale]??title;
const pageDescription=tool?.seo?.description[lang as Locale]??description;
const infoRoutes:Record<string,string>={'/id/privasi/':'/en/privacy/','/en/privacy/':'/id/privasi/','/id/info/tentang/':'/en/info/about/','/en/info/about/':'/id/info/tentang/','/id/info/bantuan/':'/en/info/help/','/en/info/help/':'/id/info/bantuan/','/id/info/kontak/':'/en/info/contact/','/en/info/contact/':'/id/info/kontak/','/id/info/ketentuan/':'/en/info/terms/','/en/info/terms/':'/id/info/ketentuan/'};
const catalogRoutes:Record<string,string>={'/id/alat/':'/en/tools/','/en/tools/':'/id/alat/'};
const alternate=tool?.path[targetLang]??catalogRoutes[pathname]??infoRoutes[pathname]??pathname.replace(en?'/en/':'/id/',`/${targetLang}/`);
const site=Astro.site??new URL('https://doculven.example');
const siteOrigin=site.origin;
const publicUrl=(path:string)=>new URL(`${basePath}${path.replace(/^\/+/, '')}`,`${siteOrigin}/`).toString();
const canonical=publicUrl(pathname);
const isProductPage=Boolean(tool)||pathname==='/id/'||pathname==='/en/';
const isHomePage=pathname===`/${lang}/`;
const catalogPath=lang==='en'?'/en/tools/':'/id/alat/';
const breadcrumbItems: Array<{ name: string; url?: string }> = trail?.length
  ? trail.map(item=>({name:item.name,url:item.path?publicUrl(item.path):undefined}))
  : !isHomePage?[
    {name:en?'Home':'Beranda',url:publicUrl(`/${lang}/`)},
    ...(tool?[{name:en?'Tools':'Alat',url:publicUrl(catalogPath)}]:[]),
    {name:tool?.name[lang as Locale]??pageTitle},
  ]:[];
const faqSchema=tool?.faq?.length?{
  '@context':'https://schema.org',
  '@type':'FAQPage',
  mainEntity:tool.faq.map(item=>({
    '@type':'Question',
    name:item.question[lang as Locale],
    acceptedAnswer:{'@type':'Answer',text:item.answer[lang as Locale]},
  })),
}:null;
const idAlternate=lang==='id'?canonical:publicUrl(alternate);
const enAlternate=lang==='en'?canonical:publicUrl(alternate);
const socialImage=ogImage?publicUrl(ogImage):publicUrl('/images/og-share.png');
const documentTitle=article?pageTitle:`${pageTitle} | Doculven`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#065F46"/><meta name="description" content={pageDescription}/>
    <title>{documentTitle}</title><link rel="canonical" href={canonical}/>
    <link rel="alternate" hreflang="id" href={idAlternate}/><link rel="alternate" hreflang="en" href={enAlternate}/><link rel="alternate" hreflang="x-default" href={enAlternate}/>
    <meta property="og:type" content={article?'article':'website'}/><meta property="og:site_name" content="Doculven"/><meta property="og:title" content={documentTitle}/><meta property="og:description" content={pageDescription}/><meta property="og:url" content={canonical}/><meta property="og:locale" content={en?'en_US':'id_ID'}/><meta property="og:image" content={socialImage}/><meta property="og:image:alt" content="Doculven image and document tools"/>
    <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={documentTitle}/><meta name="twitter:description" content={pageDescription}/><meta name="twitter:image" content={socialImage}/>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Doculven', url: publicUrl('/'), inLanguage: [ 'id', 'en' ] })}/>
    {isProductPage && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebApplication', name: pageTitle, applicationCategory: 'MultimediaApplication', operatingSystem: 'Any modern browser', description: pageDescription, url: canonical, image: socialImage })}/>}
    {breadcrumbItems.length>1 && <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:breadcrumbItems.map((item,index)=>({ '@type':'ListItem', position:index+1, name:item.name, ...(item.url?{item:item.url}:{}) })) })}/>} 
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}/>}
    {article && <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'Article', headline:pageTitle, description:pageDescription, datePublished:new Date(article.publishedAt).toISOString(), ...(article.updatedAt?{dateModified:new Date(article.updatedAt).toISOString()}:{}), inLanguage:lang, mainEntityOfPage:{'@type':'WebPage','@id':canonical}, author:{'@type':'Organization',name:'Doculven'}, publisher:{'@type':'Organization',name:'Doculven'}, image:socialImage })}/>}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>}
    <link rel="icon" href={`${basePath}favicon-96.png`} type="image/png" sizes="96x96"/><link rel="icon" href={`${basePath}favicon.svg`} type="image/svg+xml"/><link rel="apple-touch-icon" href={`${basePath}apple-touch-icon.png`}/><link rel="alternate" type="application/rss+xml" title="Doculven guides" href={`${basePath}rss.xml`}/>{tool && <ClientRouter />}
  </head>
  <body>
    <a class="skip" href="#main">{en ? 'Skip to content' : 'Lewati ke konten'}</a>
    <header class="header">
      <div class="wrap nav"><a class="brand" href={`/${lang}/`}><img src={`${basePath}brand/doculven-mark.svg`} width="34" height="34" alt="" />Doculven</a>
        <nav class="links" aria-label={en ? 'Main navigation' : 'Navigasi utama'}>
          <a href={`/${lang}/#tools`}>{en ? 'Tools' : 'Alat'}</a>
          <a href={`/${lang}/articles/`}>{en ? 'Guides' : 'Panduan'}</a>
          <a href={`/${lang}/#how`}>{en ? 'How it works' : 'Cara kerja'}</a>
          <a href={en ? '/en/privacy/' : '/id/privasi/'}>{en ? 'Privacy' : 'Privasi'}</a>
        </nav>
        <div class="nav-actions">
          <a class="language-switch" href={alternate} lang={targetLang} hreflang={targetLang} aria-label={en ? "ID — Bahasa Indonesia" : "EN — English"}><svg viewBox="0 0 24 16" width="24" height="16" aria-hidden="true">{en ? <><path fill="#fff" d="M0 0h24v16H0z"/><path fill="#ce1126" d="M0 0h24v8H0z"/></> : <><path fill="#012169" d="M0 0h24v16H0z"/><path stroke="#fff" stroke-width="4" d="m0 0 24 16m0-16L0 16"/><path stroke="#c8102e" stroke-width="1" d="m0 0 24 16m0-16L0 16"/><path stroke="#fff" stroke-width="6" d="M12 0v16M0 8h24"/><path stroke="#c8102e" stroke-width="3" d="M12 0v16M0 8h24"/></>}</svg>
            {en ? "ID" : "EN"}
          </a>
          <button class="mobile-menu-trigger" type="button" aria-haspopup="dialog" aria-controls="mobile-menu">Menu</button>
        </div>
      </div>
      <dialog class="mobile-menu" id="mobile-menu" aria-labelledby="mobile-menu-title"><div class="mobile-menu-heading"><strong id="mobile-menu-title">{en ? 'Navigation' : 'Navigasi'}</strong><button class="mobile-menu-close" type="button">{en ? 'Close' : 'Tutup'}</button></div>
        <nav aria-label={en ? 'Mobile navigation' : 'Navigasi seluler'}>
          <a href={`/${lang}/#tools`}>{en ? 'Tools' : 'Alat'}</a>
          <a href={`/${lang}/articles/`}>{en ? 'Guides' : 'Panduan'}</a>
          <a href={`/${lang}/#how`}>{en ? 'How it works' : 'Cara kerja'}</a>
          <a href={en ? '/en/privacy/' : '/id/privasi/'}>{en ? 'Privacy' : 'Privasi'}</a>
        </nav>
      </dialog>
    </header>
    <main id="main">{breadcrumbItems.length>1&&<nav class="breadcrumbs" aria-label={en?'Breadcrumb':'Jejak navigasi'}><ol>{breadcrumbItems.map((item,index)=><li>{index>0&&<span class="breadcrumb-separator" aria-hidden="true">/</span>}{item.url?<a href={new URL(item.url).pathname}>{item.name}</a>:<span aria-current="page">{item.name}</span>}</li>)}</ol></nav>}<slot /><ToolReference lang={lang as Locale} tool={tool} /><SessionTray lang={lang} /></main>
    <footer class="footer">
      <div class="wrap">
        <div class="footer-intro">
          <a class="brand" href={`/${lang}/`}><img src={`${basePath}brand/doculven-mark.svg`} width="34" height="34" alt="" />Doculven</a>
          <p>{en ? 'Edit images and documents on your device.' : 'Olah foto dan dokumen langsung di perangkatmu.'}</p>
          <a class="footer-email" href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>
        </div>
        <div class="footer-directory">
          <nav class="footer-links" aria-label={en ? 'More information' : 'Informasi lainnya'}>
            <a href={en?'/en/info/about/':'/id/info/tentang/'}>{en?'About':'Tentang'}</a>
            <a href={en?'/en/articles/':'/id/articles/'}>{en?'Guides':'Panduan'}</a>
            <a href={en?'/en/info/contact/':'/id/info/kontak/'}>{en?'Contact':'Kontak'}</a>
            <a href={en?'/en/info/help/':'/id/info/bantuan/'}>{en?'Help':'Bantuan'}</a>
            <a href={en?'/en/privacy/':'/id/privasi/'}>{en?'Privacy':'Privasi'}</a>
            <a href={en?'/en/info/terms/':'/id/info/ketentuan/'}>{en?'Terms':'Ketentuan'}</a>
          </nav>
          <p class="footer-copyright">© {new Date().getFullYear()} Doculven</p>
        </div>
      </div>
    </footer>
    <WelcomeNotice en={en} />
    {tool && <ToolFeedback en={en} />}
  </body>
</html>
<script>
  const initializeMobileMenu = () => {
    const dialog = document.querySelector<HTMLDialogElement>('#mobile-menu');
    const trigger = document.querySelector<HTMLButtonElement>('.mobile-menu-trigger');
    const close = document.querySelector<HTMLButtonElement>('.mobile-menu-close');
    if (!dialog || !trigger || !close || dialog.dataset.ready) return;
    dialog.dataset.ready = 'true';
    document.documentElement.classList.add('has-mobile-nav');
    trigger.addEventListener('click', () => dialog.showModal());
    dialog.addEventListener('close', () => trigger.focus({ preventScroll: true }));
    close.addEventListener('click', () => dialog.close());
    dialog.querySelectorAll('a').forEach(link => link.addEventListener('click', () => dialog.close()));
  };
  const initializeFileDrops = () => {
    document.querySelectorAll<HTMLInputElement>('input[type="file"]').forEach(input => {
      const label = input.closest<HTMLLabelElement>('label');
      const target = label ?? input.parentElement;
      if (!target || target.dataset.fileDropReady || (!label && target.classList.contains('drop'))) return;
      target.dataset.fileDropReady = 'true';
      const clear = () => target.classList.remove('file-drop-active');
      target.addEventListener('dragover', event => { event.preventDefault(); if (!input.disabled) target.classList.add('file-drop-active'); });
      target.addEventListener('dragleave', clear);
      target.addEventListener('drop', event => {
        event.preventDefault(); clear();
        const files = event.dataTransfer?.files;
        if (!files?.length || input.disabled) return;
        const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'files')?.set;
        setter?.call(input, files);
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });
  };
  let observedWorkspace: HTMLElement | null = null;
  let resultObserver: MutationObserver | undefined;
  const initializeResultReveal = () => {
    const workspace = document.querySelector<HTMLElement>('.workspace-compact');
    if (workspace === observedWorkspace) return;
    resultObserver?.disconnect();
    observedWorkspace = workspace;
    if (!workspace) return;
    const revealed = new WeakSet<Element>();
    const reveal = (node: Element) => {
      if (revealed.has(node)) return;
      const rect = node.getBoundingClientRect();
      const alreadyVisible = rect.top >= 0 && rect.top < window.innerHeight * 0.6;
      if (alreadyVisible) { revealed.add(node); return; }
      revealed.add(node);
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      node.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
    };
    const scan = () => {
      workspace.querySelectorAll<HTMLElement>('.result').forEach(node => {
        if (!node.textContent?.trim()) return;
        // Prefer the actual download action: the result block may also contain a
        // large comparison preview, and scrolling to its top would still leave
        // the download below the fold.
        const action = node.classList.contains('scanner-result')
          ? node
          : node.querySelector<HTMLElement>('a.download, .button.download') ?? node;
        reveal(action);
      });
    };
    resultObserver = new MutationObserver(scan);
    resultObserver.observe(workspace, { childList: true, subtree: true, characterData: true });
    scan();
  };
  document.addEventListener('astro:page-load', initializeMobileMenu);
  document.addEventListener('astro:page-load', initializeFileDrops);
  document.addEventListener('astro:page-load', initializeResultReveal);
  initializeMobileMenu();
  initializeFileDrops();
  initializeResultReveal();
</script>
