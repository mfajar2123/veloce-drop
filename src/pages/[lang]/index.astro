---
import { statSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import LandingDemo from '../../components/LandingDemo.astro';
import LandingScenarios from '../../components/LandingScenarios.astro';
import AdSlot from '../../components/AdSlot.astro';
import { articlesFor, articlePath, categoryLabel } from '../../articles';
import { catalog, type Locale } from '../../tool-registry';

export function getStaticPaths() { return [{ params: { lang: 'id' } }, { params: { lang: 'en' } }]; }
const lang = Astro.params.lang as Locale;
const en = lang === 'en';
const assets = '/images/';
const original = 'landing-workspace-sample.webp';
const compressed = 'landing-workspace-compressed.webp';
const originalBytes = statSync(`public/images/${original}`).size;
const compressedBytes = statSync(`public/images/${compressed}`).size;
const curated = catalog;
const latestGuides = (await articlesFor(lang)).slice(0, 3);
---

<Base lang={lang} title={en ? 'Precision image and document tools, on your device' : 'Olah foto dan dokumen, tetap di perangkatmu'} description={en ? 'Prepare photos and documents with local browser tools. Files are processed on your device.' : 'Siapkan foto dan dokumen dengan alat lokal di browser. Berkas diproses di perangkat Anda.'}>
  <div class="landing-page" data-lang={lang}>
    <section class="landing-hero" aria-labelledby="landing-title">
      <div class="landing-hero-copy">
        <h1 id="landing-title">{en ? 'Files ready. Still on your device.' : 'Berkas beres. Tetap di perangkatmu.'}</h1>
        <p class="landing-lede">{en ? 'Resize a portrait, compress a photo or scan a page to PDF in your browser.' : 'Atur ukuran pas foto, kecilkan berkas, atau pindai halaman jadi PDF langsung di browser.'}</p>
        <div class="actions">
          <a class="button" href="#tools">{en ? 'Choose a tool' : 'Pilih alat'}</a>
          <a class="button secondary" href={`/${lang}/articles/`}>{en ? 'Read the guides' : 'Baca panduan'}</a>
        </div>
      </div>
      <LandingDemo lang={lang} original={`${assets}${original}`} compressed={`${assets}${compressed}`} originalBytes={originalBytes} compressedBytes={compressedBytes} />
    </section>

    <section class="landing-section landing-tools" id="tools" aria-labelledby="tools-title">
      <div class="landing-section-heading">
        <h2 id="tools-title">{en ? 'What do you need to do?' : 'Apa yang ingin Anda kerjakan?'}</h2>
        <p>{en ? 'Search for a format like HEIC or a task like printing a passport photo.' : 'Cari format seperti HEIC atau pekerjaan seperti mencetak pas foto.'}</p>
      </div>
      <div class="home-tool-search">
        <label for="home-tool-query">{en ? 'Search tools' : 'Cari alat'}</label>
        <input id="home-tool-query" type="search" autocomplete="off" placeholder={en ? 'Try “passport”, “PDF”, or “HEIC”' : 'Coba “pas foto”, “PDF”, atau “HEIC”'} />
        <p class="notice" data-home-tool-count aria-live="polite"></p>
      </div>
      <div class="home-tool-list" id="home-tool-list" data-home-tool-list>
        {curated.map((tool, index) => <a class="home-tool-row" href={tool.path[lang]} data-default-hidden={index >= 6 ? 'true' : 'false'} hidden={index >= 6} data-search-text={`${tool.name.id} ${tool.name.en} ${tool.description.id} ${tool.description.en} ${tool.keywords}`}>
          <strong>{tool.name[lang]}</strong><span>{tool.description[lang]}</span>
        </a>)}
      </div>
      <p class="home-tool-empty" data-home-tool-empty hidden>{en ? 'No matching tools. Try a shorter search.' : 'Belum ada alat yang cocok. Coba kata yang lebih singkat.'}</p>
      <button class="text-link home-tool-toggle" type="button" data-home-tool-toggle aria-controls="home-tool-list" aria-expanded="false">{en ? `Show ${curated.length - 6} more tools` : `Tampilkan ${curated.length - 6} alat lain`}</button>
      <p class="home-catalog-link"><a class="text-link" href={en ? '/en/tools/' : '/id/alat/'}>{en ? 'Open the full tools catalog' : 'Buka katalog alat lengkap'}</a></p>
    </section>

    <AdSlot placement="home-after-tool-search" />

    <section class="landing-section landing-use-cases" aria-labelledby="use-cases-title">
      <div class="landing-section-heading">
        <h2 id="use-cases-title">{en ? 'What are you preparing?' : 'Berkas apa yang sedang Anda siapkan?'}</h2>
      </div>
      <LandingScenarios lang={lang} />
    </section>

    <section class="landing-section print-size-demo" aria-labelledby="print-size-title">
      <div>
        <h2 id="print-size-title">{en ? 'How large is a passport photo on A4?' : 'Seberapa besar pas foto di kertas A4?'}</h2>
        <p>{en ? 'Choose a print size to see its proportions on the sheet.' : 'Pilih ukuran cetak untuk melihat perbandingannya dengan selembar kertas.'}</p>
        <label for="print-size">{en ? 'Photo size' : 'Ukuran pas foto'}</label>
        <select id="print-size"><option>2 × 3 cm</option><option selected>3 × 4 cm</option><option>4 × 6 cm</option></select>
        <a class="text-link" href={catalog.find(tool => tool.id === 'print')!.path[lang]}>{en ? 'Arrange my print sheet' : 'Susun lembar cetak saya'}</a>
      </div>
      <div class="paper-stage" aria-hidden="true"><div class="paper-sheet"><div class="photo-outline"></div><small>A4 · 210 × 297 mm</small></div></div>
    </section>
    <section class="landing-section landing-privacy" id="how" aria-labelledby="privacy-title">
      <div class="privacy-story">
        <h2 id="privacy-title">{en ? 'Your browser does the processing.' : 'Browser Anda yang mengolah berkas.'}</h2>
        <ol class="privacy-steps">
          <li><strong>{en ? 'Choose a file' : 'Pilih berkas'}</strong><span>{en ? 'Open a tool and select a local image or document.' : 'Buka alat lalu pilih foto atau dokumen dari perangkat.'}</span></li>
          <li><strong>{en ? 'Make your changes' : 'Atur hasilnya'}</strong><span>{en ? 'Preview dimensions and settings before exporting.' : 'Periksa pratinjau dan pengaturan sebelum mengekspor.'}</span></li>
          <li><strong>{en ? 'Download when ready' : 'Unduh saat siap'}</strong><span>{en ? 'The page creates the output in your browser.' : 'Halaman membuat hasil langsung di browser.'}</span></li>
        </ol>
        <p class="notice">{en ? 'Your files are not sent to a server for processing. Loading the site and public assets still uses a network connection.' : 'Berkas tidak dikirim ke server untuk diproses. Memuat halaman dan aset publik tetap menggunakan jaringan.'}</p>
        <a class="text-link" href={en ? '/en/privacy/' : '/id/privasi/'}>{en ? 'How local processing works' : 'Pelajari pemrosesan lokal'}</a>
      </div>
      <figure class="privacy-image">
        <img src="/images/landing-product-sample.webp" srcset="/images/landing-product-sample-768.webp 768w, /images/landing-product-sample.webp 1024w" sizes="(max-width: 768px) 100vw, 42vw" alt={en ? 'A workstation with monitors and a keyboard' : 'Meja kerja dengan monitor dan papan ketik'} width="1024" height="623" loading="lazy" />
        <figcaption><a href="https://www.flickr.com/photos/7655955@N07/7015159835">Full Desk · Hexidecimal</a> · <a href="https://creativecommons.org/licenses/by-sa/2.0/">CC BY-SA 2.0</a></figcaption>
      </figure>
    </section>

    <section class="landing-section landing-guides" aria-labelledby="guides-title">
      <div class="landing-section-heading">
        <h2 id="guides-title">{en ? 'Answers before you upload.' : 'Jawaban sebelum Anda mengunggah.'}</h2>
        <p>{en ? 'Short, specific guides on file sizes, formats and the rules that reject a file. Written from how these tools actually behave.' : 'Panduan singkat dan spesifik tentang ukuran berkas, format, dan aturan yang membuat berkas ditolak. Ditulis dari perilaku nyata alat ini.'}</p>
      </div>
      <nav class="guide-shortcuts" aria-label={en ? 'Guides with sample files' : 'Panduan dengan berkas contoh'}>
        { (en ? [
          ['scan-paper-to-pdf', 'Scan paper to an A4 PDF'],
          ['heic-to-jpg-on-windows', 'Convert an iPhone HEIC on Windows'],
        ] : [
          ['passport-photo-sizes-explained', 'Cek ukuran pas foto 3×4'],
          ['reduce-upload-photo-size', 'Coba kompres foto ke 200 KB'],
        ]).map(([slug, label]) => <a class="text-link" href={`/${lang}/articles/${slug}/`}>{label}</a>) }
      </nav>
      <ul class="guide-highlights">
        {latestGuides.map(guide => (
          <li class="guide-highlight">
            <a href={articlePath(guide)}>
              {guide.data.image && <img src={guide.data.image} alt="" width="1200" height="800" loading="lazy" decoding="async" />}
              <span class="guide-highlight-body">
                <span class="guide-highlight-topic">{categoryLabel[guide.data.category]?.[lang] ?? guide.data.category}</span>
                <strong>{guide.data.title}</strong>
                <span class="guide-highlight-summary">{guide.data.summary}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="home-catalog-link"><a class="text-link" href={`/${lang}/articles/`}>{en ? 'Read all guides' : 'Baca semua panduan'}</a></p>
    </section>

    <section class="landing-close" aria-labelledby="close-title">
      <p class="eyebrow">{en ? 'A practical next step' : 'Langkah berikutnya'}</p>
      <h2 id="close-title">{en ? 'Make the file fit its next step.' : 'Siapkan berkas untuk langkah berikutnya.'}</h2>
      <a class="button" href={en ? '/en/tools/' : '/id/alat/'}>{en ? 'Choose from all tools' : 'Pilih dari semua alat'}</a>
    </section>

    <script>
      function setupHomeSearch() {
        const root = document.querySelector<HTMLElement>('.landing-page');
        if (!root || root.dataset.searchReady) return;
        root.dataset.searchReady = 'true';
        const input = root.querySelector<HTMLInputElement>('#home-tool-query')!;
        const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-search-text]'));
        const count = root.querySelector<HTMLElement>('[data-home-tool-count]')!;
        const empty = root.querySelector<HTMLElement>('[data-home-tool-empty]')!;
        const toggle = root.querySelector<HTMLButtonElement>('[data-home-tool-toggle]')!;
        const shown = rows.filter(row => row.dataset.defaultHidden !== 'true').length;
        const en = root.dataset.lang === 'en';
        let expanded = false;
        function update() {
          const words = input.value.toLocaleLowerCase().trim().split(/\s+/).filter(Boolean);
          const searching = words.length > 0;
          let visible = 0;
          for (const row of rows) {
            const text = (row.dataset.searchText ?? '').toLocaleLowerCase();
            const match = words.every(word => text.includes(word));
            row.hidden = !match || (!searching && !expanded && row.dataset.defaultHidden === 'true');
            if (!row.hidden) visible++;
          }
          empty.hidden = visible > 0;
          toggle.hidden = searching;
          toggle.setAttribute('aria-expanded', String(expanded));
          toggle.textContent = expanded ? (en ? 'Show fewer tools' : 'Tampilkan lebih sedikit') : (en ? `Show ${rows.length - shown} more tools` : `Tampilkan ${rows.length - shown} alat lain`);
          count.textContent = searching ? (en ? `${visible} matching tools` : `${visible} alat cocok`) : (expanded ? (en ? `All ${rows.length} tools` : `Semua ${rows.length} alat`) : (en ? `${shown} of ${rows.length} tools` : `${shown} dari ${rows.length} alat`));
        }
        input.addEventListener('input', update);
        toggle.addEventListener('click', () => {
          expanded = !expanded;
          update();
        });
        update();
      }
      document.addEventListener('astro:page-load', setupHomeSearch);
      setupHomeSearch();
    </script>
  </div>
</Base>
