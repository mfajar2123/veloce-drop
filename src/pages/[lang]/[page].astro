---
import Base from '../../layouts/Base.astro';
import Compressor from '../../components/Compressor';
import { catalog } from '../../tool-registry';
export function getStaticPaths(){return [
...catalog.filter(tool=>tool.id.startsWith('compress-')&&tool.targetKB).flatMap(tool=>(['id','en'] as const).map(lang=>({params:{lang,page:tool.path[lang].split('/').filter(Boolean).at(-1)},props:{target:tool.targetKB}}))),
{params:{lang:'id',page:'privasi'}},{params:{lang:'en',page:'privacy'}}]}
const {target = 200} = Astro.props as {target?:number};
const {lang = 'id',page} = Astro.params; const en = lang === 'en'; const privacy = page === 'privacy' || page === 'privasi';
const title = privacy ? (en ? 'Privacy' : 'Privasi') : (en ? `Compress image to ${target===1000?'1 MB':`${target} KB`}` : `Kompres foto ke ${target===1000?'1 MB':`${target} KB`}`);
const description = privacy
  ? (en ? 'Learn how files are processed in your browser, kept temporarily in session memory, and which site assets still use a network connection.' : 'Pelajari cara berkas diproses di browser, disimpan sementara dalam memori sesi, dan aset situs yang tetap memerlukan jaringan.')
  : (en ? `Compress an image to ${target===1000?'1 MB':`${target} KB`} locally in your browser.` : `Kompres gambar ke ${target===1000?'1 MB':`${target} KB`} secara lokal di browser Anda.`);
---
<Base lang={lang} title={title} description={description}><div class="wrap workspace">{privacy ? <article class="info privacy-page"><h1>{title}</h1><p class="lead">{en ? 'Image and document tools process selected files in your browser on your device. This describes file processing, not a claim that loading the website is offline.' : 'Alat gambar dan dokumen memproses berkas yang Anda pilih di browser pada perangkat Anda. Ini menjelaskan pemrosesan berkas, bukan berarti situs dimuat tanpa jaringan.'}</p><section><h2>{en ? 'Files and results' : 'Berkas dan hasil'}</h2><p>{en ? 'Input files and generated results are kept in page memory while you work. Cross-tool handoffs can place up to five results in the session tray, with a combined 50 MB limit and 30-minute expiry. You can remove an item or clear the tray. Reloading or closing the page clears the app-held session.' : 'Berkas masukan dan hasil disimpan di memori halaman selama Anda bekerja. Alur lintas alat dapat menyimpan hingga lima hasil dalam tray sesi, dengan batas total 50 MB dan masa berlaku 30 menit. Anda bisa menghapus satu hasil atau membersihkan tray. Memuat ulang atau menutup halaman menghapus sesi aplikasi.'}</p><p>{en ? 'The app does not intentionally write file bytes, thumbnails, filenames, or results to URLs, localStorage, IndexedDB, analytics, or a service worker cache. The browser controls downloaded files and may retain them according to its own settings.' : 'Aplikasi tidak dengan sengaja menulis byte berkas, thumbnail, nama file, atau hasil ke URL, localStorage, IndexedDB, analitik, atau cache service worker. Berkas yang diunduh mengikuti pengaturan browser Anda.'}</p></section><section><h2>{en ? 'Network requests' : 'Permintaan jaringan'}</h2><p>{en ? 'The page, self-hosted fonts, and public application assets use network requests. Background removal asks to load its public same-origin model and runtime only after you select that action. The image itself stays in browser processing memory.' : 'Halaman, font self-hosted, dan aset publik aplikasi memakai jaringan. Penghapus latar meminta model dan runtime publik dari origin yang sama setelah Anda memilih tindakan tersebut. Gambar tetap berada di memori pemrosesan browser.'}</p></section><section><h2>{en ? 'No advertising or analytics configured' : 'Iklan dan analitik belum dikonfigurasi'}</h2><p>{en ? 'This build has no advertising publisher, third-party analytics, account, or file-upload API. If those services are added later, their network requests, consent requirements, and policy must be reviewed and this notice updated.' : 'Build ini tidak memiliki publisher iklan, analitik pihak ketiga, akun, atau API unggah berkas. Jika layanan tersebut ditambahkan, permintaan jaringan, persetujuan, dan kebijakannya harus ditinjau lalu pemberitahuan ini diperbarui.'}</p></section><section><h2>{en ? 'Limits and reporting' : 'Batasan dan laporan'}</h2><p>{en ? 'Browser libraries may keep temporary decoded buffers, and large files can use substantial device memory. Processing behavior and support vary by format and device. Security headers depend on the static host configuration. Do not include sensitive files when reporting a problem.' : 'Pustaka browser dapat menyimpan buffer dekode sementara, dan berkas besar dapat memakai banyak memori perangkat. Dukungan format dan perilaku proses berbeda menurut alat dan perangkat. Header keamanan bergantung pada konfigurasi host statis. Jangan sertakan berkas sensitif saat melaporkan masalah.'}</p></section></article> : <><h1>{title}</h1><p class="lead">{en ? 'Choose an image, set a target, and download the actual result.' : 'Pilih gambar, tentukan target, lalu unduh hasilnya.'}</p><Compressor lang={lang} initialTarget={target} client:load/><section class="info"><h2>{en ? 'About the result' : 'Tentang hasilnya'}</h2><p>{en ? 'The tool samples compression qualities and reports the real file size. Some images cannot reach a small target without reducing dimensions. JPEG and WebP are lossy formats.' : 'Alat mencoba beberapa tingkat kualitas dan menampilkan ukuran berkas yang sebenarnya. Sebagian gambar tidak dapat mencapai target kecil tanpa mengurangi dimensi. JPEG dan WebP menggunakan kompresi lossy.'}</p></section></>}</div></Base>
